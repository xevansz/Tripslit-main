# TripSplit Backend Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# For demo mode (no MongoDB needed): Set USE_DUMMY_DB=true
# For production: Set USE_DUMMY_DB=false and provide MONGO_URL
USE_DUMMY_DB=true
MONGO_URL=mongodb://localhost:27017/tripsplit
DB_NAME=tripsplit

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-secret-key-here

# Optional: AI Features (requires emergentintegrations package)
# EMERGENT_LLM_KEY=your-emergent-api-key
